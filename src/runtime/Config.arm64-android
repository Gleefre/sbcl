# grab the directory of the config prior to including any other files
CONFIG_DIR := $(dir $(lastword $(MAKEFILE_LIST)))

-include ../../output/ndk-config

CC=${TOOLCHAIN}/bin/${TARGET_TAG}${ANDROID_API}-clang
LD=${TOOLCHAIN}/${TARGET_TAG}/bin/ld

ASSEM_SRC = arm64-assem.S
ARCH_SRC = arm64-arch.c

CFLAGS += -march=armv8

OS_SRC = linux-os.c linux-mman.c arm64-linux-os.c android-os.c arm64-android-os.c
OS_LIBS = -ldl

# On Android -no-pie is not supported
DISABLE_PIE=no

CFLAGS += -std=gnu99 -Wunused-parameter -fno-omit-frame-pointer -momit-leaf-frame-pointer
LINKFLAGS += -Wl,--export-dynamic
SOFLAGS += -Wl,-soname,libsbcl.so
OS_LIBS += -Wl,-no-as-needed

# Search for precompiled android libraries in output/android-libs
# Use a relative path so that it works in tools-for-build
CFLAGS += -I$(CONFIG_DIR)../../output/android-libs
DEPEND_FLAGS += -I$(CONFIG_DIR)../../output/android-libs
LINKFLAGS += -L$(CONFIG_DIR)../../output/android-libs
SOFLAGS += -L$(CONFIG_DIR)../../output/android-libs

ifdef LISP_FEATURE_LARGEFILE
  CFLAGS += -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
endif

# pthread is part of libc on Android, so there is no need to add it to OS_LIBS

ifdef LISP_FEATURE_SB_CORE_COMPRESSION
  OS_LIBS += -lzstd
endif

# libunwind?

ifdef LISP_FEATURE_IMMOBILE_SPACE
  GC_SRC = fullcgc.c gencgc.c traceroot.c immobile-space.c
else ifdef LISP_FEATURE_MARK_REGION_GC
# The parallelized mark-region collector can perform a full GC,
# but can't use fullcgc to perform heap->arena pointer detection.
  GC_SRC = fullcgc.c pmrgc.c traceroot.c mark-region.c incremental-compact.c gc-thread-pool.c
else
  GC_SRC = fullcgc.c gencgc.c traceroot.c
endif

ifdef LISP_FEATURE_SB_LINKABLE_RUNTIME
  LIBSBCL = sbcl.o
  USE_LIBSBCL = sbcl.o
endif

# -*- makefile -*- for the C-level run-time support for SBCL

# This software is part of the SBCL system. See the README file for
# more information.
#
# This software is derived from the CMU CL system, which was
# written at Carnegie Mellon University and released into the
# public domain. The software is in the public domain and is
# provided with absolutely no warranty. See the COPYING and CREDITS
# files for more information.

# grab the directory of the config prior to including any other files
CONFIG_DIR := $(dir $(lastword $(MAKEFILE_LIST)))

-include ../../output/ndk-config

CC=${TOOLCHAIN}/bin/${TARGET_TAG}${ANDROID_API}-clang
LD=${TOOLCHAIN}/${TARGET_TAG}/bin/ld

ASSEM_SRC = x86-assem.S
ARCH_SRC = x86-arch.c

CFLAGS += -m32
LINKFLAGS += -m32
__LDFLAGS__ = -m elf_i386

OS_SRC = linux-os.c linux-mman.c x86-linux-os.c android-os.c x86-android-os.c
OS_LIBS = -ldl

# On Android -no-pie is not supported
# See GNUMakefile -- this might be a problem for 32-bit builds...
DISABLE_PIE=no

CFLAGS += -std=gnu99 -Wunused-parameter -fno-omit-frame-pointer -momit-leaf-frame-pointer
LINKFLAGS += -Wl,--export-dynamic
SOFLAGS += -Wl,-soname,libsbcl.so
OS_LIBS += -Wl,-no-as-needed

# Search for precompiled android libraries in android-libs or android-libs/arch
# Use a relative path so that it works in tools-for-build
CFLAGS += -I$(CONFIG_DIR)../../android-libs/x86 -I$(CONFIG_DIR)../../android-libs
DEPEND_FLAGS += -I$(CONFIG_DIR)../../android-libs/x86 -I$(CONFIG_DIR)../../android-libs
LINKFLAGS += -L$(CONFIG_DIR)../../android-libs/x86 -L$(CONFIG_DIR)../../android-libs
SOFLAGS += -L$(CONFIG_DIR)../../android-libs/x86 -L$(CONFIG_DIR)../../android-libs

ifdef LISP_FEATURE_LARGEFILE
  CFLAGS += -D_LARGEFILE_SOURCE -D_LARGEFILE64_SOURCE -D_FILE_OFFSET_BITS=64
endif

# pthread is part of libc on Android, so there is no need to add it to OS_LIBS

ifdef LISP_FEATURE_SB_CORE_COMPRESSION
  OS_LIBS += -lzstd
endif

ifdef HAVE_LIBUNWIND
  OS_LIBS += -lunwind
endif

# mark-region gc and immobile space aren't supported
GC_SRC = fullcgc.c gencgc.c traceroot.c

ifdef LISP_FEATURE_SB_LINKABLE_RUNTIME
  LIBSBCL = sbcl.o
  USE_LIBSBCL = sbcl.o
endif
